# Python
__pycache__/
*.py[cod]

# Large data files
*.h5ad
*.h5
*.loom
*.zarr/

# The reference values that the reproduction image compares against are
# versioned even though the package-level ignore rules exclude scientific data
# files by default.
!README.md
!data/**/*.csv
!data/**/*.txt

# Raw and generated outputs are local only.
outputs/
*.jsonl
