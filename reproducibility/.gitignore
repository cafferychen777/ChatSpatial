# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Environment
.env
.venv/
env/

# Large data files
*.h5ad
*.h5
*.loom
*.zarr/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Curated, compact evidence is versioned even though the package-level ignore
# rules exclude scientific data files by default.
!README.md
!requirements-paper.txt
!data/**/README.md
!data/**/*.csv
!data/**/*.txt
!supplementary_tables/**/*.csv

# Raw and generated outputs are local only.
outputs/
*.jsonl
